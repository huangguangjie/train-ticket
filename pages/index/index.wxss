/** index.wxss 极简扁平 **/

.container {
  min-height: 100vh;
  padding: 48rpx 32rpx 140rpx;
  box-sizing: border-box;
}

.search-card {
  background: #fff;
  padding: 48rpx 40rpx;
}

.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.search-row:last-of-type {
  margin-bottom: 0;
}

.station-box {
  flex: 1;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
}

.station-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.station-value {
  font-size: 32rpx;
  color: #111;
  font-weight: 500;
}

.swap-icon {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.date-row {
  justify-content: space-between;
  padding: 32rpx 0;
  margin-top: 32rpx;
  border-top: 1rpx solid #eee;
}

.date-label {
  font-size: 28rpx;
  color: #666;
}

.date-value {
  font-size: 28rpx;
  color: #111;
}

.search-btn {
  display: block;
  width: 90%;
  margin: 40rpx auto 0;
  background: #c41e3a;
  color: #fff;
  padding: 22rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 500;
}
