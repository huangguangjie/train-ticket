<!--index.wxml-->
<view class="container">
  <view class="welcome-section">
    <text class="welcome-title">欢迎使用个性化助手</text>
    <text class="welcome-subtitle">您的智能生活伙伴</text>
  </view>
  
  <view class="feature-grid">
    <view class="feature-card" bindtap="goToProfile">
      <image class="feature-icon" src="/images/profile.png"></image>
      <text class="feature-name">个人信息</text>
    </view>
    
    <view class="feature-card" bindtap="goToCalendar">
      <image class="feature-icon" src="/images/calendar.png"></image>
      <text class="feature-name">日程管理</text>
    </view>
    
    <view class="feature-card" bindtap="goToSettings">
      <image class="feature-icon" src="/images/settings.png"></image>
      <text class="feature-name">设置中心</text>
    </view>
    
    <view class="feature-card" bindtap="goToLogs">
      <image class="feature-icon" src="/images/logs.png"></image>
      <text class="feature-name">访问记录</text>
    </view>
  </view>
  
  <view class="quote-section">
    <text class="quote-text">{{dailyQuote}}</text>
    <text class="quote-author">- 每日一言</text>
  </view>
  
  <view class="userinfo" wx:if="{{hasUserInfo}}">
    <image class="userinfo-avatar" src="{{userInfo.avatarUrl}}" bindtap="goToProfile"></image>
    <text class="userinfo-nickname" bindtap="goToProfile">{{userInfo.nickName}}</text>
  </view>
  <button class="login-btn" wx:else bindtap="getUserProfile">一键登录</button>
</view>