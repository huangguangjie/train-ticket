/** settings.wxss 极简扁平 **/

.container {
  min-height: 100vh;
  padding: 48rpx 32rpx 140rpx;
  box-sizing: border-box;
}

.setting-section {
  background: #fff;
  margin-bottom: 24rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 40rpx;
  border-bottom: 1rpx solid #eee;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-text {
  font-size: 30rpx;
  color: #111;
}

.arrow {
  font-size: 28rpx;
  color: #999;
}

.switch-item {
  padding-right: 20rpx;
}

.switch {
  transform: scale(0.85);
}
