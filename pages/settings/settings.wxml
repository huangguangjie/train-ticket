<!-- settings.wxml -->
<view class="container">
  <view class="setting-section">
    <view class="setting-item" bindtap="clearStorage">
      <text class="setting-text">清除缓存</text>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="changeTheme">
      <text class="setting-text">主题设置</text>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="aboutApp">
      <text class="setting-text">关于我们</text>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="feedback">
      <text class="setting-text">意见反馈</text>
      <text class="arrow">›</text>
    </view>
  </view>
  
  <view class="setting-section">
    <view class="setting-item switch-item">
      <text class="setting-text">开启通知</text>
      <switch class="switch" checked="{{enableNotification}}" bindchange="toggleNotification" />
    </view>
    <view class="setting-item switch-item">
      <text class="setting-text">深色模式</text>
      <switch class="switch" checked="{{darkMode}}" bindchange="toggleDarkMode" />
    </view>
  </view>
  
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>