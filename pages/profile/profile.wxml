<!--profile.wxml-->
<view class="container">
  <view class="profile-header">
    <view class="avatar-wrapper">
      <image class="avatar" src="{{userInfo.avatarUrl}}"></image>
      <text class="nickname">{{userInfo.nickName}}</text>
    </view>
  </view>
  
  <view class="profile-info">
    <view class="info-item">
      <text class="label">性别</text>
      <text class="value">{{userInfo.gender === 1 ? '男' : userInfo.gender === 2 ? '女' : '未知'}}</text>
    </view>
    <view class="info-item">
      <text class="label">城市</text>
      <text class="value">{{userInfo.city}}</text>
    </view>
    <view class="info-item">
      <text class="label">国家</text>
      <text class="value">{{userInfo.country}}</text>
    </view>
    <view class="info-item">
      <text class="label">省份</text>
      <text class="value">{{userInfo.province}}</text>
    </view>
  </view>
  
  <view class="profile-stats">
    <view class="stat-item">
      <text class="stat-number">{{visitCount}}</text>
      <text class="stat-label">访问次数</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{dayCount}}</text>
      <text class="stat-label">连续访问天数</text>
    </view>
  </view>
  
  <button class="logout-btn" bindtap="getUserProfile">更新头像昵称</button>
</view>