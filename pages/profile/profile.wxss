/** profile.wxss 极简扁平 **/

.container {
  min-height: 100vh;
  padding: 48rpx 32rpx 140rpx;
  box-sizing: border-box;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111;
}

.order-count {
  font-size: 26rpx;
  color: #999;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.order-card {
  background: #fff;
  padding: 40rpx 36rpx;
}

.order-route {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.station {
  font-size: 32rpx;
  font-weight: 500;
  color: #111;
}

.station.from {
  color: #111;
}

.arrow {
  margin: 0 16rpx;
  color: #999;
  font-size: 24rpx;
}

.order-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.passengers {
  font-size: 26rpx;
  color: #666;
}

.price {
  font-size: 32rpx;
  font-weight: 600;
  color: #c41e3a;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.go-buy-btn {
  background: #c41e3a;
  color: #fff;
  padding: 24rpx 56rpx;
  border: none;
  font-size: 28rpx;
}
